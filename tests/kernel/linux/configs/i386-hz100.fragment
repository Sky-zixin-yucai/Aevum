# Linux i386 基准配置，和 Aevum 的 100Hz 单核对齐
CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_SMP=n
CONFIG_NR_CPUS=1
CONFIG_HZ=100
CONFIG_HZ_100=y
CONFIG_HZ_250=n
CONFIG_HZ_300=n
CONFIG_HZ_1000=n
CONFIG_HIGH_RES_TIMERS=n
CONFIG_NO_HZ_IDLE=n
CONFIG_PREEMPT_NONE=y
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT=n
CONFIG_SCHED_DEBUG=y
CONFIG_SCHEDSTATS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
