# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Build outputs and local tooling
build/
src/kernel/host/console/robot/kernel.elf
src/kernel/host/console/robot/os.img
src/kernel/host/console/robot/build-baseline/
interface/desktop/node_modules/
interface/desktop/dist-app/
interface/desktop/dist/
interface/desktop/dist-run*/
interface/desktop/qml-world/dist/
interface/desktop/qml-world/build/
interface/desktop/qml-world/*.spec
archive/backend-python/monitor/dist/
archive/backend-python/monitor/build/
*.obj
*.lib
*.exp
*.exe
*.pdb
*.ilk
*.log

# Model weights and checkpoints never enter the repository
*.pt
*.safetensors
*.ckpt
checkpoint*/
build/trainer.out.log
build/trainer.err.log
build/training_metrics.jsonl
# Real model fixtures stay local
engine/tests/fixtures/
# 测试目录只在本地运行
engine/tests/
# 模型文件不进入仓库
*.vrm
*.pmx
*.glb
# 通用建模的 3R 示例是小型测试模型，允许入库
!interface/web/forge/samples/arm3.glb
# 项目专用模型目录允许入库，供其他维护者复用
!interface/web/models/
!interface/web/models/**/*.gltf
!interface/web/models/**/*.glb
!interface/web/models/**/*.bin
engine/assets/
# 外部参考实现与源码包只在本地
labs/reference/
*.tgz

# P2P 运行期数据
runtime/
# 本地运行配置，按 configs/ 样例生成
/config.yaml

# 内核测试本地产出与外部源码
.excluded/
tests/kernel/results/*
!tests/kernel/results/README.md
tests/kernel/linux/rootfs/
tests/kernel/linux/.config
src/kernel/host/console/robot/build-bench/
src/kernel/host/console/robot/build-rt/
src/kernel/host/console/robot/build-*/
